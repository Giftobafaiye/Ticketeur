# ─── Public (Next.js) ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ─── Database (Postgres) ────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/ticketur"

# ─── Better Auth ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"

# Comma-separated list of trusted origins (apps that share auth)
APP_URLS="http://localhost:3000,http://localhost:3001"

# ─── Google OAuth (optional) ────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: Sign in with Apple (Services ID + client-secret JWT) and Facebook Login.
# A provider's button only appears when both of its values are set.
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ─── Trigger.dev (outbound emails — password reset, 2FA, verification) ──
TRIGGER_PROJECT_ID=""
TRIGGER_SECRET_KEY=""

# ─── Resend (read by packages/jobs when running) ────────────────────────
RESEND_API_KEY=""

# ─── Brevo (standby transport behind Resend) ────────────────────────────
# Resend's free plan stops at ~200 emails a day — a ceiling shared with
# ticket confirmations. When Resend refuses for want of capacity (rate limit
# or daily/monthly quota) the message is sent through Brevo instead. Leave
# blank to disable the fallback.
BREVO_API_KEY=""

# ─── Admin 2FA copy list ────────────────────────────────────────────────
# Comma-separated addresses that receive a copy of every ADMIN sign-in code,
# alongside the admin signing in. Admin accounts only; ordinary users' codes
# are never copied. Treat each address as being as sensitive as the admin
# password: whoever reads it can complete an admin sign-in. Blank = no copies.
ADMIN_OTP_COPY_EMAILS=""

# ─── Vercel Blob (uploads) ──────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ─── Organizer payouts ──────────────────────────────────────────────────
# off | manual | live — the same value as the web app and Trigger.dev. The
# admin app never calls Flutterwave for payouts: in `live` mode approving
# hands the payout to the Trigger.dev worker, which sends it.
PAYOUTS_MODE="off"
