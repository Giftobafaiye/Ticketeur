{"version":3,"file":"users.js","sources":["../../../src/users.ts"],"sourcesContent":["import HTTPClient from './httpClient.js';\n\nexport namespace users {\n  const encodePath = (value: string): string => encodeURIComponent(value);\n\n  export interface UserRole {\n    id: string;\n    name: string;\n    [key: string]: unknown;\n  }\n\n  export interface User {\n    id: string;\n    name: string;\n    emails?: string[];\n    email?: string;\n    role?: UserRole | null;\n    [key: string]: unknown;\n  }\n\n  export class Service extends HTTPClient {\n    private readonly localPath = '/v2/users';\n\n    /**\n     * @see https://axiom.co/docs/restapi/endpoints/getCurrentUser\n     */\n    current = (): Promise<User> => this.client.get('/v2/user');\n\n    /**\n     * @see https://axiom.co/docs/restapi/endpoints/getUsers\n     */\n    list = (): Promise<User[]> => this.client.get(this.localPath);\n\n    /**\n     * @see https://axiom.co/docs/restapi/endpoints/getUser\n     */\n    get = (id: string): Promise<User> => this.client.get(`${this.localPath}/${encodePath(id)}`);\n  }\n}\n"],"names":[],"mappings":";;AAEM,IAAW;AAAjB,CAAA,UAAiB,KAAK,EAAA;IACpB,MAAM,UAAU,GAAG,CAAC,KAAa,KAAa,kBAAkB,CAAC,KAAK,CAAC;IAiBvE,MAAa,OAAQ,SAAQ,UAAU,CAAA;QACpB,SAAS,GAAG,WAAW;AAExC;;AAEG;AACH,QAAA,OAAO,GAAG,MAAqB,IAAI,CAAC,MAAM,CAAC,GAAG,CAAC,UAAU,CAAC;AAE1D;;AAEG;AACH,QAAA,IAAI,GAAG,MAAuB,IAAI,CAAC,MAAM,CAAC,GAAG,CAAC,IAAI,CAAC,SAAS,CAAC;AAE7D;;AAEG;QACH,GAAG,GAAG,CAAC,EAAU,KAAoB,IAAI,CAAC,MAAM,CAAC,GAAG,CAAC,CAAA,EAAG,IAAI,CAAC,SAAS,CAAA,CAAA,EAAI,UAAU,CAAC,EAAE,CAAC,CAAA,CAAE,CAAC;AAC5F;AAjBY,IAAA,KAAA,CAAA,OAAO,UAiBnB;AACH,CAAC,EApCgB,KAAK,KAAL,KAAK,GAAA,EAAA,CAAA,CAAA;;;;"}