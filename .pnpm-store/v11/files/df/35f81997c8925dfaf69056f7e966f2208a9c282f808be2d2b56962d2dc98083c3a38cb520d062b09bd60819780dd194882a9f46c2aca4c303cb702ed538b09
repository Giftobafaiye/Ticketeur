{"version":3,"file":"compare-DUeKXGOW.js","names":[],"sources":["../src/lib/compare.ts"],"sourcesContent":["import type { Query } from './search-params'\n\n// Replaces inline `(a, b) => a === b` calls for bundle size reduction.\nexport function isEqual(a: unknown, b: unknown): boolean {\n  return a === b\n}\n\nexport function compareArrays<T>(\n  a: T[],\n  b: T[],\n  eq: (a: T, b: T) => boolean\n): boolean {\n  return (\n    a === b ||\n    (a.length === b.length && a.every((value, index) => eq(value, b[index]!)))\n  )\n}\n\nexport function compareQuery<T extends Query>(\n  a: T | null,\n  b: T | null\n): boolean {\n  if (a === b) {\n    return true // Referentially stable\n  }\n  if (a === null || b === null) {\n    return false\n  }\n  // we expect either strings or arrays, not a mix of both\n  if (typeof a === 'string' || typeof b === 'string') {\n    return false\n  }\n\n  if (a.length !== b.length) {\n    return false\n  }\n\n  return a.every((value, index) => value === b[index]!)\n}\n"],"mappings":";AAGA,SAAgB,QAAQ,GAAY,GAAqB;CACvD,OAAO,MAAM;AACf;AAEA,SAAgB,cACd,GACA,GACA,IACS;CACT,OACE,MAAM,KACL,EAAE,WAAW,EAAE,UAAU,EAAE,OAAO,OAAO,UAAU,GAAG,OAAO,EAAE,MAAO,CAAC;AAE5E;AAEA,SAAgB,aACd,GACA,GACS;CACT,IAAI,MAAM,GACR,OAAO;CAET,IAAI,MAAM,QAAQ,MAAM,MACtB,OAAO;CAGT,IAAI,OAAO,MAAM,YAAY,OAAO,MAAM,UACxC,OAAO;CAGT,IAAI,EAAE,WAAW,EAAE,QACjB,OAAO;CAGT,OAAO,EAAE,OAAO,OAAO,UAAU,UAAU,EAAE,MAAO;AACtD"}