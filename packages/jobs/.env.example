# Read by trigger.config.ts and src/tasks/*.
# DATABASE_URL is transitively required via the @ticketur/db import chain.

DATABASE_URL="postgresql://user:password@localhost:5432/ticketur"

# ─── Trigger.dev ────────────────────────────────────────────────────────
# Project ID from https://cloud.trigger.dev (required to run `trigger dev`)
TRIGGER_PROJECT_ID=""
# Only needed for `trigger deploy`
TRIGGER_SECRET_KEY=""

# ─── Resend (used inside each task via src/utils/resend.ts) ─────────────
RESEND_API_KEY=""

# ─── Brevo (standby transport behind Resend) ────────────────────────────
# Resend's free plan stops at ~200 emails a day — a ceiling shared with
# ticket confirmations. When Resend refuses for want of capacity (rate limit
# or daily/monthly quota) the message is sent through Brevo instead. Leave
# blank to disable the fallback.
BREVO_API_KEY=""

# ─── Order reconciliation (src/tasks/reconcile-pending-orders.ts) ───────
# The web app's canonical public URL, which the scheduled task calls (a URL
# that redirects is refused), and the bearer secret the web app expects: the
# same CRON_SECRET value the web app has.
NEXT_PUBLIC_APP_URL=""
CRON_SECRET=""

# ─── Organizer payouts (src/tasks/{execute-payout,settle-payout-transfer,
#     reconcile-payouts}.ts) ─────────────────────────────────────────────
# off | manual | live — the same value as both Vercel projects. In `live`
# mode this worker sends the transfers, so it also needs the Flutterwave
# secret key, and this project's Trigger.dev static IPs must be whitelisted
# in the Flutterwave dashboard (Settings → Whitelisted IP addresses), with
# "Transfer via API" switched on. A TEST key (FLWSECK_TEST-…) makes every
# transfer a mocked success after a minute, for end-to-end testing.
PAYOUTS_MODE="off"
FLW_SECRET_KEY=""
